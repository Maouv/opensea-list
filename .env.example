# Opensea api key
OPENSEA_API_KEY=

# PRIVATE_KEYS=key1,key2,key3
PRIVATE_KEYS=

# BOT TELEGRAM
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

#RPC URL
RPC_URL_ETHEREUM=
RPC_URL_POLYGON=
RPC_URL_BASE=
RPC_URL_ARC=
RPC_URL_ROBINHOOD=

# --- Mint speed (all optional) ---
# Extra RPC endpoints per chain, comma separated. Signed mint txs go to primary + extras at once.
# RPC_URL_ROBINHOOD_EXTRA=https://second-provider...
# Schedules: heavy prep at T-20s, fresh nonce/fee + socket warm-up at T-2s, fire at T.
# MINT_PREWARM_SEC=20
# MINT_REFRESH_SEC=2
# MINT_FIRE_LEAD_MS=0        # >0 = send slightly before T; too early = NotActive revert + wasted gas
# MINT_TIP_GWEI=             # override priority fee (default: node suggestion, 1 gwei fallback)
# MINT_GAS_LIMIT=            # override gas limit when estimateGas can't run
# FAST_LOCAL_CALLDATA=0      # 1 = build SeaDrop mintPublic locally and pre-sign even for OS drops
#                            # (fastest, but UNVERIFIED against OS-built calldata: test on a live drop first)
